ck*)은 메이저 레이블이 아닌 독립(*independent*) 레이블이나 자가 제작 방식으로 음악을 내놓는 록 밴드들의 실천에서 비롯된 장르 개념으로, 1980년대 초 영미 언더그라운드 씬에서 자리를 잡았다. 단순히 유통 방식을 가리키는 개념에서 출발했지만, 점차 반상업적 미학, 실험적 태도, 절제된 프로덕션을 선호하는 음악적 감수성을 뜻하는 말로 굳어졌다.\n\n스미스(*The Smiths*), 픽시스(*Pixies*), 페이브먼트(*Pavement*) 등이 초기 인디 록의 음향적 틀을 만들었으며, 1990년대 이후 얼터너티브 록(*alternative rock*)과 상당 부분 겹치면서도 독자적인 정체성을 유지해 왔다. 2000년대 들어 스트록스(*The Strokes*), 아케이드 파이어(*Arcade Fire*) 등이 주류의 관심을 받으면서 '인디'라는 수식어 자체가 음악적 스타일과 문화적 태도를 동시에 가리키는 개념으로 확장됐다.","position":3,"album_count":0,"children":[{"id":"db589075-2a4c-4fdb-b3a4-54b6b03355b4","slug":"slacker-rock","label":"Slacker Rock","parent_id":"85de63a7-ee61-4c1c-96ef-79400f4d3d4e","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"736373ce-f48d-403a-bc5b-0cc8b5da96f4","slug":"lo-fi-indie","label":"Lo-Fi (Indie)","parent_id":"85de63a7-ee61-4c1c-96ef-79400f4d3d4e","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"00d56323-c3af-4b41-b6c5-0df4f7447e10","slug":"midwest-emo","label":"Midwest Emo","parent_id":"85de63a7-ee61-4c1c-96ef-79400f4d3d4e","definition_md":"","position":103,"album_count":0,"children":[]},{"id":"7d51ffc8-fcba-4e64-8ea2-62168f0401bb","slug":"slowcore","label":"Slowcore","parent_id":"85de63a7-ee61-4c1c-96ef-79400f4d3d4e","definition_md":"","position":104,"album_count":0,"children":[{"id":"ed489d8f-c226-4f1c-98bf-e2a4615a312f","slug":"sadcore","label":"Sadcore","parent_id":"7d51ffc8-fcba-4e64-8ea2-62168f0401bb","definition_md":"","position":101,"album_count":0,"children":[]}]},{"id":"0fadb7e7-644a-4f7e-b850-a852dbad3677","slug":"post-hardcore","label":"Post-Hardcore","parent_id":"85de63a7-ee61-4c1c-96ef-79400f4d3d4e","definition_md":"","position":105,"album_count":0,"children":[{"id":"7bd6ff04-2b03-4c56-a64c-f28b5b29a853","slug":"emocore","label":"Emocore","parent_id":"0fadb7e7-644a-4f7e-b850-a852dbad3677","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"df2fe759-1dd4-4a65-b831-4c928c01ddbb","slug":"screamo","label":"S