af1-900b-8cf0eeb23deb","definition_md":"","position":106,"album_count":0,"children":[]},{"id":"7bbbf4f3-5290-44ba-836b-a068e03e62b3","slug":"idol-ballad","label":"Idol Ballad","parent_id":"9d4fdc22-c905-4af1-900b-8cf0eeb23deb","definition_md":"","position":107,"album_count":0,"children":[]},{"id":"8b2b8d47-ab8b-42af-83db-d1b0f84fbc5c","slug":"rock-idol","label":"Rock Idol","parent_id":"9d4fdc22-c905-4af1-900b-8cf0eeb23deb","definition_md":"","position":108,"album_count":0,"children":[]},{"id":"9735d194-cc29-454d-8147-fbe17bd1a32a","slug":"city-pop-idol","label":"City Pop Idol","parent_id":"9d4fdc22-c905-4af1-900b-8cf0eeb23deb","definition_md":"","position":109,"album_count":0,"children":[]}]},{"id":"d98994e6-dfa0-42f6-995d-6da29d97e98d","slug":"k-ballad","label":"K-Ballad","parent_id":"2a3fbf55-b940-4b92-aba8-7252e503222f","definition_md":"**케이발라드**(*K-Ballad*)는 한국 대중음악에서 감성적인 멜로디와 섬세한 보컬 표현을 중심으로 한 슬로 발라드 장르로, 케이팝의 서정적 축을 담당한다. 서구의 팝 발라드(*pop ballad*) 형식을 기반으로 하되, 한국적 정서인 이별·그리움·애절함을 강조하는 멜로디 진행과 고음 절정부(*climax*)가 두드러지는 것이 특징이다.\n\n1980~90년대 이선희, 변진섭, 신승훈 등이 장르의 원형을 다졌으며, 이후 아이돌 그룹들도 앨범에 발라드 트랙을 필수적으로 포함시키면서 케이팝과 케이발라드의 경계가 흐려졌다. 아이유(*IU*)의 《밤 편지》, 폴킴(*Paul Kim*)의 서정적 음반들이 현재 케이발라드의 대표 사례로 자주 거론된다.","position":2,"album_count":0,"children":[{"id":"4ba32d4d-25df-48db-aedd-95f621af7fa8","slug":"k-rock-ballad","label":"Korean Rock Ballad","parent_id":"d98994e6-dfa0-42f6-995d-6da29d97e98d","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"ac44f479-a823-4eba-9d94-4f659c49ed84","slug":"k-rnb-ballad","label":"Korean R&B Ballad","parent_id":"d98994e6-dfa0-42f6-995d-6da29d97e98d","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"4b2ca294-d3cd-4665-826b-ec117724f18d","slug":"k-ost-ballad","label":"K-Drama OST Ballad","parent_id":"d98994e6-dfa0-42f6-995d-6da29d97e98d","definition_md":"","position":103,"album_count":0,"children":[]},{"id":"d227784f-c295-49d3-ba78-1dab08b0e123","slug":"korean-adult-contemporary","label":"Korean Adult Contemporary","parent_id":"d98994e6-dfa0-42f6-995d-6da29d97e98d","definition_md":"","position":104,"album_count":0,"children":[]},{"id":"04004c1f-b047-42e5-ac20-8513e4192a5c","slug":"korean-folk-ballad","label":"Korean Folk Ballad","parent_id":"d98994e6-dfa0-42f6-995d-6da29d97e98d","definition_md":"","position":105,"album_count":0,"children":[]}]},{"id":"3b0bff17-37d1-48ca-ad94-3427d255a001","slug":"trot","label":"Trot","parent_id":"2a3fbf55-b940-4b92-aba8-7252e503222f","definition_md":"**트로트**(*Trot*)는 한국의 가장 오래된 대중음악 장르 중 하나로, 일제강점기에 일본의 엔카(*演歌, enka*)와 서양 폭스트롯(*foxtrot*) 리듬이 결합해 형성된 것으로 알려져 있다. 2박자 혹은 4박자의 단순한 리듬 위에 꺾기(*melisma*)를 활용한 창법과 애수 어린 멜로디가 핵심 특징이며, 케이팝 아이돌 음악과는 달리 단독 보컬의 감정 표현에 무게 중심이 있다.\n\n나훈아, 남진이 1960~70년대 트로트의 전성기를 이끈 대표 가수로 꼽히며, 이후 한동안 젊은 세대로부터 멀어졌다가 2020년대 들어 TV 오디션 프로그램을 계기로 **트로트 르네상스**가 일어나며 임영웅·송가인 등의 스타가 탄생했다. 이 복고 열풍은 트로트가 세대를 초월한 한국 대중음악의 뿌리임을 재확인시켰다.","position":101,"album_count":0,"children":[{"id":"dc6c0b7a-dc38-4c71-842c-aa7ea5ba656d","slug":"semi-trot","label":"Semi-Trot","parent_id":"3b0bff17-37d1-48ca-ad94-3427d255a001","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"bf52713f-5037-41fc-a388-3c64a9664b02","slug":"trot-pop","label":"Trot Pop","parent_id":"3b0bff17-37d1-48ca-ad94-3427d255a001","definition_md":"","position":102,"album_count":0,"children":[]}]}]},{"id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","slug":"pop","label":"Pop","parent_id":null,"definition_md":"**팝**(*pop*, *pop music*)은 대중에게 폭넓게 호소하는 것을 목표로 설계된 **상업적 대중음악**의 가장 광범위한 범주로, 짧고 기억하기 쉬운 멜로디와 반복 후렴구를 중심으로 구성된다.\n\n팝은 1950년대 로큰롤(*rock and roll*)과 틴 팬 앨리(*Tin Pan Alley*)의 교차점에서 형태를 갖추기 시작했으며, 라디오 방송과 레코드 산업의 성장을 배경으로 독자적인 음악 형식으로 자리 잡았다. 음악적으로는 버스-코러스-브릿지로 이어지는 절-후렴 구조(*verse-chorus form*)를 핵심 골격으로 삼고, 리드미컬한 드럼 비트, 화성적으로 안정된 코드 진행, 그리고 중간 템포의 멜로디 중심 편곡이 두드러진다. 초기에는 어쿠스틱 악기와 현악 편곡이 주를 이뤘으나, 시대에 따라 신시사이저(*synthesizer*)·전자 드럼·샘플링(*sampling*) 등 당대 기술을 적극 흡수해왔다.\n\n1960년대 비틀스(*The Beatles*)와 모타운(*Motown*) 사운드가 팝의 황금 문법을 확립했고, 1980년대 마이클 잭슨(*Michael Jackson*)의 《Thriller》(1982)가 글로벌 팝의 상업적 정점을 보여줬다. 이후 팝은 댄스-팝(*dance-pop*)·신스팝(*synth-pop*)·틴 팝(*teen pop*)·일렉트로팝(*electropop*) 등 수많은 하위 장르를 파생시키며 각 시대의 프로덕션 트렌드를 포용해왔다. 아리아나 그란데(*Ariana Grande*)·테일러 스위프트(*Taylor Swift*)·더 위켄드(*The Weeknd*) 등이 2010년대 이후 현대 팝의 지형을 대표한다.\n\n한국에서는 1990년대 서태지와 아이들의 등장 이후 댄스 음악과 결합한 아이돌 팝이 주류로 자리 잡았고, 2010년대부터는 K-팝(*K-pop*)이라는 이름으로 세계 시장에서 독자적인 팝 문화를 형성하고 있다. 팝은 특정 스타일이라기보다 **접근성과 상업성을 내재한 음악적 태도**로, 끊임없이 주변 장르를 흡수하고 재정의되는 살아있는 개념이다.","position":1,"album_count":1253,"children":[{"id":"b6f077b3-2d14-4de3-9592-15e450c4dac0","slug":"j-pop","label":"J-Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**J-팝**(*J-Pop*, Japanese Pop)은 1990년대 초 일본에서 본격적으로 명명된 일본 대중음악 장르로, 서양 팝·록·R&B 어법을 흡수하되 일본어 가사와 특유의 화성 감각(반음 이동 코드 진행 등)을 결합한 것이 핵심이다. 소속사 주도의 아이돌 시스템, 고품질 제작, TV 타이업 전략이 장르 확산을 이끌었다.\n\n주요 아티스트로는 우타다 히카루(*Utada Hikaru*)·구라키 마이(*倉木麻衣*)·아무로 나미에(*安室奈美恵*) 등이 있으며, 《First Love》(1999)는 일본 역대 최다 판매 앨범 중 하나로 꼽힌다. J-팝은 한국 아이돌 산업의 초기 모델이 되었고, 아시아 전역에서 폭넓은 영향력을 행사했다.","position":1,"album_count":0,"children":[{"id":"f4b0cb1c-4067-4387-82d4-cf3820caca7b","slug":"shibuya-kei","label":"Shibuya-kei","parent_id":"b6f077b3-2d14-4de3-9592-15e450c4dac0","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"9b3c43b0-bec7-447a-a896-777f4cae1ae3","slug":"idol-kayo","label":"Idol Kayō","parent_id":"b6f077b3-2d14-4de3-9592-15e450c4dac0","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"179ad4bc-c462-411f-bcc1-2a340d4745fb","slug":"kayokyoku","label":"Kayōkyoku","parent_id":"b6f077b3-2d14-4de3-9592-15e450c4dac0","definition_md":"","position":103,"album_count":0,"children":[{"id":"f6bbf7ea-d1bb-4481-8bf2-a90552b9a8ab","slug":"enka","label":"Enka","parent_id":"179ad4bc-c462-411f-bcc1-2a340d4745fb","definition_md":"","position":101,"album_count":0,"children":[]}]},{"id":"316fd972-e5b3-410f-84c1-85ffec1d6f0d","slug":"anison","label":"Anison","parent_id":"b6f077b3-2d14-4de3-9592-15e450c4dac0","definition_md":"","position":104,"album_count":0,"children":[{"id":"9391e39b-37f1-4433-82f8-3880a6293960","slug":"anime-opening-ending-theme","label":"Anime Opening / Ending Theme","parent_id":"316fd972-e5b3-410f-84c1-85ffec1d6f0d","definition_md":"","position":101,"album_count":0,"children":[]}]},{"id":"c9e303ae-8035-41e1-a2f1-c1818def0752","slug":"denpa-song","label":"Denpa Song","parent_id":"b6f077b3-2d14-4de3-9592-15e450c4dac0","definition_md":"","position":105,"album_count":0,"children":[]},{"id":"5938a50d-01b2-4980-8bf6-448591ef0249","slug":"j-rock","label":"J-Rock","parent_id":"b6f077b3-2d14-4de3-9592-15e450c4dac0","definition_md":"","position":106,"album_count":0,"children":[{"id":"7564bd05-bfc6-4c53-890d-b7d3c02387ae","slug":"visual-kei","label":"Visual Kei","parent_id":"5938a50d-01b2-4980-8bf6-448591ef0249","definition_md":"","position":101,"album_count":0,"children":[]}]}]},{"id":"f3713a89-cf70-4edb-928a-8cf5447637c2","slug":"hyperpop","label":"Hyperpop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**하이퍼팝**(*hyperpop*)은 2010년대 후반 인터넷 문화를 기반으로 등장한 팝의 극단적 변형으로, 오토튠을 과도하게 적용한 보컬, 귀를 찌르는 고음역 신스, 트랩(*trap*)·EDM 비트를 충돌시키며 의도적으로 '과잉'된 사운드를 추구한다. 영국 레이블 PC 뮤직(*PC Music*)과 A. G. 쿡(*A. G. Cook*)이 이 미학을 선도했고, 이후 100 젝(*100 gecs*)·차를리 XCX(*Charli XCX*)·소피(*SOPHIE*) 등이 장르를 대중화했다.\n\n하이퍼팝은 팝의 달콤함과 노이즈·글리치를 동시에 껴안으며, 기존 장르 경계를 의도적으로 허문다는 점에서 일렉트로팝(*electropop*)이나 댄스팝(*dance-pop*)과 구별된다. 멜로디와 불협화음 사이를 아슬아슬하게 오가는 이 스타일은 2020년대 들어 K-pop 프로듀서들에게도 영향을 미쳤다.","position":2,"album_count":0,"children":[{"id":"97c29b71-1c95-472a-b4e4-b08511bc858b","slug":"bubblegum-bass","label":"Bubblegum Bass","parent_id":"f3713a89-cf70-4edb-928a-8cf5447637c2","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"e6e19835-f1ac-4a89-b51d-42b462c4589d","slug":"glitchcore","label":"Glitchcore","parent_id":"f3713a89-cf70-4edb-928a-8cf5447637c2","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"287b29bf-7c63-44b8-901f-0999c184586e","slug":"digicore","label":"Digicore","parent_id":"f3713a89-cf70-4edb-928a-8cf5447637c2","definition_md":"","position":103,"album_count":0,"children":[]},{"id":"9efefb8a-6827-4553-85ea-0a3e2bf265cd","slug":"dariacore","label":"Dariacore","parent_id":"f3713a89-cf70-4edb-928a-8cf5447637c2","definition_md":"","position":104,"album_count":0,"children":[]}]},{"id":"c1945dc6-5ee9-4c91-933b-14b144b0f86f","slug":"city-pop","label":"City Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**시티 팝**(*city pop*, *シティ・ポップ*)은 1970년대 후반부터 1980년대 일본에서 도시 생활의 세련됨과 풍요로움을 반영하며 발전한 팝 장르로, 소프트 록(*soft rock*)·퓨전 재즈(*fusion jazz*)·R&B·디스코(*disco*)의 어법을 매끄럽게 혼합한 **어반 소피스티케이션 팝**이다. 일본의 경제 호황기를 배경으로 한 여유롭고 감각적인 분위기가 장르의 핵심 정서다.\n\n야마시타 타츠로(*山下達郎*, Yamashita Tatsuro)·마쓰다 세이코(*松田聖子*, Matsuda Seiko)·다케우치 마리야(*竹内まりや*, Takeuchi Mariya)가 이 장르의 대표 아티스트로, 다케우치의 〈Plastic Love〉는 2010년대 후반 유튜브 알고리즘을 통해 전 세계적으로 재발견되며 시티 팝 복고 열풍을 이끌었다. 한국에서도 이 흐름에 영향받은 아티스트들이 등장해 한국형 시티 팝이라는 맥락이 형성됐다.","position":3,"album_count":0,"children":[{"id":"d6578424-020d-435c-affc-9918757d63ac","slug":"future-funk","label":"Future Funk","parent_id":"c1945dc6-5ee9-4c91-933b-14b144b0f86f","definition_md":"","position":101,"album_count":0,"children":[]}]},{"id":"2db8eb71-5c84-4868-b6d7-70162d9fcab8","slug":"bedroom-pop","label":"Bedroom Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**베드룸 팝**(*bedroom pop*)은 전문 스튜디오가 아닌 침실이나 개인 홈 스튜디오에서 **저예산 DIY 방식으로 제작된 인디 팝**의 한 갈래다. 거칠고 친밀한 녹음 질감, 나지막하고 내성적인 보컬, 몽롱한 리버브와 로파이(*lo-fi*) 질감이 결합되어 개인적이고 고독한 분위기를 만들어낸다. 홈 레코딩 소프트웨어의 대중화와 SoundCloud·Bandcamp 같은 플랫폼의 성장을 배경으로 2010년대에 독립적인 장르 이름을 얻었다.\n\n클레이로(*Clairo*)가 침실에서 찍은 유튜브 영상으로 주목받으며 이 장르를 대중에게 각인시켰고, 렉스 오렌지 카운티(*Rex Orange County*)·피비 브리저스(*Phoebe Bridgers*)의 초기 작업도 유사한 감수성을 공유한다. 한국에서는 혁오(*Hyukoh*)나 잔나비(*Jannabi*) 등 인디 씬의 여러 아티스트가 비슷한 자가 제작 미학을 구사하며 공감을 얻었다.","position":4,"album_count":0,"children":[]},{"id":"5ef93d31-5eea-4e00-8817-bba96544c8f9","slug":"p-pop","label":"P-Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**P-팝**(*P-Pop*, Philippine Pop)은 2010년대 후반 필리핀에서 K-팝(*K-Pop*)의 아이돌 시스템·안무·프로덕션 방식을 참조해 형성된 아이돌 팝 장르로, OPM의 하위 흐름이자 동시에 독자적인 흐름으로 간주된다. 퍼포먼스 중심의 퍼포먼스, 영어·타갈로그어 혼용 가사, SNS 팬덤 문화가 특징이다.\n\nSB19이 P-팝을 국제적으로 알린 선구자로 꼽히며, BINI·BGYO 등이 후속 주자로 성장했다. P-팝은 '아시아 아이돌 팝'의 다극화를 보여주는 사례로, 동남아시아 팝 씬에서 필리핀의 존재감을 높이는 데 기여하고 있다.","position":5,"album_count":0,"children":[]},{"id":"8ea440a6-df52-4bb4-bca6-b9dcd3d5e57b","slug":"opm","label":"OPM","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**OPM**(*Original Pilipino Music*, 오리지널 필리피노 뮤직)은 필리핀에서 창작·연주되는 대중음악 전반을 가리키는 포괄적 명칭으로, 1970년대 자국어(필리피노어·타갈로그어) 팝의 자생적 성장을 계기로 정착했다. 서양 팝·록 구조 위에 따뜻하고 감정적인 멜로디를 얹은 발라드가 OPM의 대표 얼굴이다.\n\n프레디 아길라(*Freddie Aguilar*)의 〈Anak〉(1978)이 OPM 정체성을 세계에 알린 곡으로 꼽히며, 레아 살롱가(*Lea Salonga*)·마틴 니뇨(*Martin Nievera*)·세바스찬 카스트로(*Sebastian Castro*) 등이 각 시대를 대표한다. 최근에는 OPM이 P-팝(*P-Pop*)과 병존하며 독립·인디 씬까지 포괄하는 방향으로 확장되고 있다.","position":6,"album_count":0,"children":[{"id":"8cc25d3c-16a7-4351-b137-593cc08e361d","slug":"manila-sound","label":"Manila Sound","parent_id":"8ea440a6-df52-4bb4-bca6-b9dcd3d5e57b","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"e4941c5a-1811-4dea-a037-31c767df0cbd","slug":"pinoy-rock","label":"Pinoy Rock","parent_id":"8ea440a6-df52-4bb4-bca6-b9dcd3d5e57b","definition_md":"","position":102,"album_count":0,"children":[]}]},{"id":"3b296944-3223-40a0-a7f5-ac5510581eea","slug":"synth-pop","label":"Synth-Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**신스팝**(*synth-pop*)은 1970년대 후반~1980년대 초 영국과 독일을 중심으로 등장한 팝 장르로, 신시사이저(*synthesizer*)와 드럼 머신(*drum machine*)을 주 악기로 삼아 기존의 기타·베이스 중심 팝 구조를 대체한 것이 핵심이다. 냉랭하고 미래지향적인 음색과 미니멀한 편곡이 특징이다.\n\n크라프트베르크(*Kraftwerk*)가 이 사운드의 원류를 열었고, 디페시 모드(*Depeche Mode*)·유리스믹스(*Eurythmics*)·페트 샵 보이스(*Pet Shop Boys*) 등이 1980년대에 장르를 대중화했다. 신스팝은 이후 일렉트로팝·하이퍼팝·인디트로니카(*indietronica*)에 이르는 전자 팝 계열 전반의 공통 어법을 정립한, 현대 팝에서 가장 영향력 있는 원류 중 하나다.","position":7,"album_count":0,"children":[{"id":"b4cc7d87-c083-4bb9-96de-d88f7ac77476","slug":"new-romantic","label":"New Romantic","parent_id":"3b296944-3223-40a0-a7f5-ac5510581eea","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"6c87d3c7-ac3b-4259-b091-5fe38b113c91","slug":"futurepop","label":"Futurepop","parent_id":"3b296944-3223-40a0-a7f5-ac5510581eea","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"3332738f-b709-4d8e-af37-eb41463551a1","slug":"minimal-synth","label":"Minimal Synth","parent_id":"3b296944-3223-40a0-a7f5-ac5510581eea","definition_md":"","position":103,"album_count":0,"children":[]},{"id":"f2aef914-4cfb-4d37-9899-d4f3a6194002","slug":"synthwave-pop","label":"Synthwave-Pop","parent_id":"3b296944-3223-40a0-a7f5-ac5510581eea","definition_md":"","position":104,"album_count":0,"children":[]},{"id":"eb8edd34-e738-4bd9-b5c4-c07df05fd887","slug":"freestyle","label":"Freestyle","parent_id":"3b296944-3223-40a0-a7f5-ac5510581eea","definition_md":"","position":105,"album_count":0,"children":[]}]},{"id":"e4029730-6fdd-463f-8aa1-1297298f530e","slug":"dance-pop","label":"Dance-Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**댄스팝**(*dance-pop*)은 팝 음악의 멜로디 중심 구조에 **클럽 댄스 음악의 비트와 프로덕션**을 결합한 장르로, 에너지 넘치는 리듬·신시사이저 훅·전자 드럼이 경쾌하고 직선적인 그루브를 만들어낸다. 1980년대 초 마돈나(*Madonna*)와 마이클 잭슨(*Michael Jackson*)이 이 형식을 대중음악의 주류로 끌어올렸으며, 이후 팝의 가장 상업적으로 강력한 하위 장르 중 하나로 자리 잡았다.\n\n유로댄스(*eurodance*)·일렉트로팝·하우스(*house*) 등 다양한 전자음악 트렌드를 빠르게 흡수하며 각 시대마다 새로운 형태로 변화해왔다. 카일리 미노그(*Kylie Minogue*)·브리트니 스피어스(*Britney Spears*)·레이디 가가(*Lady Gaga*)가 각 세대를 대표하는 댄스팝 아이콘이며, K-팝의 아이돌 팝 역시 댄스팝의 구조와 미학을 핵심 축으로 삼는다.","position":8,"album_count":0,"children":[{"id":"2cecfb27-cd3f-4198-884d-64f540dee396","slug":"hi-nrg","label":"Hi-NRG","parent_id":"e4029730-6fdd-463f-8aa1-1297298f530e","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"cc25504e-180c-4c75-baf8-24dfa9da9781","slug":"italo-disco","label":"Italo Disco","parent_id":"e4029730-6fdd-463f-8aa1-1297298f530e","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"502744c2-6567-419b-b803-9ef561d282d8","slug":"eurodance","label":"Eurodance","parent_id":"e4029730-6fdd-463f-8aa1-1297298f530e","definition_md":"","position":103,"album_count":0,"children":[{"id":"5a3e9992-70b8-4972-8a66-c7d2b2a0e783","slug":"eurobeat","label":"Eurobeat","parent_id":"502744c2-6567-419b-b803-9ef561d282d8","definition_md":"","position":101,"album_count":0,"children":[]}]},{"id":"36149c50-0024-4ee2-952b-07cc53d2c5f0","slug":"europop","label":"Europop","parent_id":"e4029730-6fdd-463f-8aa1-1297298f530e","definition_md":"","position":104,"album_count":0,"children":[]}]},{"id":"c66a14af-aec2-4a76-a613-866d3b22efe3","slug":"electropop","label":"Electropop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**일렉트로팝**(*electropop*)은 신시사이저와 전자 드럼머신을 주된 악기로 삼아 **차갑고 세련된 전자음향 질감** 위에 팝 멜로디를 얹는 장르다. 신스팝(*synth-pop*)과 밀접하지만, 일렉트로팝은 보다 현대적인 프로덕션 기법과 미니멀한 배열을 강조하며 1980년대 신스팝 이후 2000년대에 독립적인 이름을 얻었다. 보컬은 오토튠(*auto-tune*)이나 보코더(*vocoder*) 처리 없이도 전자적 배경 위에 깔끔하게 배치되는 경우가 많다.\n\n레이디 가가(*Lady Gaga*)의 초기 작업·카일리 미노그(*Kylie Minogue*)의 리바이벌 앨범·La Roux·퍼퓸(*Perfume*, 일본)이 이 장르의 다양한 면모를 보여준다. 2000년대 후반 인디 씬에서 클래식 신스팝의 미학을 현대 팝 프로덕션으로 재해석하는 흐름이 일어나면서 일렉트로팝은 주류와 인디 양쪽에서 모두 활성화됐다.","position":9,"album_count":0,"children":[{"id":"4e5bdf24-66d8-4588-9f3b-f69672969fab","slug":"indietronica","label":"Indietronica","parent_id":"c66a14af-aec2-4a76-a613-866d3b22efe3","definition_md":"","position":101,"album_count":0,"children":[]}]},{"id":"48edd6e0-1c0f-469a-b072-f2ce126b04ba","slug":"art-pop","label":"Art Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**아트 팝**(*art pop*)은 팝 음악의 대중성과 순수예술·전위음악의 미학적 야심을 결합한 장르로, 캐치한 멜로디와 세련된 편곡 위에 개념적이거나 실험적인 요소를 얹는 것이 특징이다. 1960년대 중반 영국의 아트 록(*art rock*) 운동과 팝 아트(*pop art*) 문화가 교차하는 지점에서 싹텄으며, 브라이언 페리(*Bryan Ferry*)와 록시 뮤직(*Roxy Music*)이 이 방향성을 초기에 구체화했다.\n\n팝의 구조적 틀을 유지하면서도 클래식·재즈·현대음악·영화음악 등의 어법을 자유롭게 차용하고, 앨범 아트와 무대 비주얼까지 하나의 통합된 예술적 비전으로 구성하는 경향이 강하다. 데이비드 보위(*David Bowie*)의 《Heroes》(1977), 케이트 부시(*Kate Bush*)의 《Hounds of Love》(1985), 비욕(*Björk*)의 《Homogenic》(1997) 등이 대표적인 이정표로 꼽힌다.","position":10,"album_count":0,"children":[{"id":"fd87f60e-c271-4119-a039-fc3cccbf2e33","slug":"avant-pop","label":"Avant-Pop","parent_id":"48edd6e0-1c0f-469a-b072-f2ce126b04ba","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"1d526e65-4bad-4336-89cc-5ae1b5a5c0c4","slug":"experimental-pop","label":"Experimental Pop","parent_id":"48edd6e0-1c0f-469a-b072-f2ce126b04ba","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"7744141b-06dc-4521-8e5e-bd0f31ae35e5","slug":"progressive-pop","label":"Progressive Pop","parent_id":"48edd6e0-1c0f-469a-b072-f2ce126b04ba","definition_md":"","position":103,"album_count":0,"children":[]},{"id":"fe9cdb8e-1775-4cda-b416-f80dcb953c52","slug":"hypnagogic-pop","label":"Hypnagogic Pop","parent_id":"48edd6e0-1c0f-469a-b072-f2ce126b04ba","definition_md":"","position":104,"album_count":0,"children":[]}]},{"id":"b3069866-c65a-45e2-8681-7fe41409a44e","slug":"indie-pop","label":"Indie Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**인디 팝**(*indie pop*)은 1980년대 영국 독립 레이블(*independent label*) 씬에서 싹튼 팝 장르로, 주류 상업 팝의 과잉 제작을 거부하고 소규모 예산과 자기 주도적 방식으로 만든 밝고 감성적인 사운드를 핵심으로 한다. 클린 기타 팝 멜로디, 소박한 편곡, 직접적이고 내면적인 가사가 특징이다.\n\n스미더린스(*The Smithereens*)·오렌지 주스(*Orange Juice*)·벨 앤드 세바스찬(*Belle and Sebastian*) 등이 초기 계보를 형성했으며, 2000년대 이후에는 인터넷 유통과 결합하면서 베드룸 팝(*bedroom pop*)이나 드림 팝(*dream pop*)과 경계를 공유하게 됐다. 인디 팝은 '인디'가 하나의 태도이자 미학임을 정착시킨 장르다.","position":11,"album_count":0,"children":[{"id":"66f9837e-a255-4348-9841-3345cf2bd52c","slug":"twee-pop","label":"Twee Pop","parent_id":"b3069866-c65a-45e2-8681-7fe41409a44e","definition_md":"","position":101,"album_count":0,"children":[{"id":"3c1fa6dd-06c5-4528-b7ab-258739f70eac","slug":"c86","label":"C86","parent_id":"66f9837e-a255-4348-9841-3345cf2bd52c","definition_md":"","position":101,"album_count":0,"children":[]}]},{"id":"99e4d104-e497-43e3-824a-c934cdbcdbdc","slug":"noise-pop","label":"Noise Pop","parent_id":"b3069866-c65a-45e2-8681-7fe41409a44e","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"2728570d-fd3a-40ee-bb4d-1300be466713","slug":"chamber-indie","label":"Chamber Indie","parent_id":"b3069866-c65a-45e2-8681-7fe41409a44e","definition_md":"","position":103,"album_count":0,"children":[]},{"id":"43452918-0683-4a05-960f-b02c504afb48","slug":"indie-surf","label":"Indie Surf","parent_id":"b3069866-c65a-45e2-8681-7fe41409a44e","definition_md":"","position":104,"album_count":0,"children":[]}]},{"id":"2c18493b-8aec-467f-854b-4a5a71b86348","slug":"baroque-pop","label":"Baroque Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**바로크 팝**(*baroque pop*)은 1960년대 중반 영미권에서 등장한 팝 하위 장르로, 하프시코드·현악 4중주·오보에·트럼펫 등 **바로크 시대 클래식 편곡**을 팝 송 구조 안에 접목한 것이 핵심 특징이다. 비틀스(*The Beatles*)의 〈Eleanor Rigby〉(1966)와 비치 보이스(*The Beach Boys*)의 《Pet Sounds》(1966)가 이 양식의 출발점으로 자주 언급된다.\n\n로코코풍의 정교한 카운터멜로디와 풍성한 현악 편성이 팝의 단순한 화성을 한층 복잡하고 화려하게 만들며, 멜로디의 서정성을 강조한다. 버트 배커랙(*Burt Bacharach*)의 정교한 편곡, 스콧 워커(*Scott Walker*)의 초기 솔로 작업, 그리고 1990년대 이후 아케이드 파이어(*Arcade Fire*)나 수프얀 스티븐스(*Sufjan Stevens*) 같은 아티스트들이 이 어법을 현대적으로 계승했다.","position":12,"album_count":0,"children":[]},{"id":"6c19bece-3d79-4d74-a851-37c74b52da71","slug":"chamber-pop","label":"Chamber Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**챔버 팝**(*chamber pop*)은 실내악(*chamber music*)의 편성과 팝 구조를 결합한 장르로, 현악 앙상블·피아노·목관악기·하프 등 어쿠스틱 악기를 **정교하게 편곡하여 팝 멜로디를 감싸는** 방식이 특징이다. 바로크 팝보다 현대적이고 실험적인 경향이 강하며, 인디 팝(*indie pop*)과의 접점도 뚜렷하다. 주로 1990년대 중반 이후 미국과 영국 인디 씬에서 활성화됐다.\n\n스코티시 팝(*Scottish pop*)의 벨 앤드 세바스티안(*Belle and Sebastian*)과 그들의 《If You're Feeling Sinister》(1996), 수프얀 스티븐스(*Sufjan Stevens*)의 《Illinois》(2005), 그리고 더 신세틱스(*The Tindersticks*) 등이 대표적인 아티스트로 꼽힌다. 작은 편성의 정밀한 악기 운용과 서정적 텍스트가 챔버 팝을 오케스트라 팝(*orchestral pop*)과 구분 짓는 핵심이다.","position":13,"album_count":0,"children":[]},{"id":"104fb080-2949-4c5d-ba0b-34c2047fa9e1","slug":"mandopop-c-pop","label":"Mandopop / C-Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**만다팝**(*Mandopop*) 혹은 **C-팝**(*C-Pop*)은 주로 북경어(만다린)로 노래하는 중화권 팝 음악을 가리키며, 대만·홍콩·중국 본토를 중심으로 발전했다. 1970~80년대 대만의 캠퍼스 포크 운동(*校園民歌*)에서 출발해 서양 팝과 R&B를 흡수하며 동아시아 전역에 영향을 미쳤다.\n\n테레사 텡(*鄧麗君, Teresa Teng*)은 만다팝의 원형적 아이콘이며, 1990~2000년대에는 장쉐요우(*張學友*)·류더화(*劉德華*)·저우제룬(*周杰倫, Jay Chou*) 등이 장르를 현대화했다. 저우제룬의 《范特西》(2001)는 R&B·힙합·고전 중국 요소를 융합하며 만다팝의 폭을 크게 확장한 작품으로 평가받는다.","position":14,"album_count":0,"children":[{"id":"356e2819-693d-455b-b599-d87b495e34f4","slug":"shidaiqu","label":"Shidaiqu","parent_id":"104fb080-2949-4c5d-ba0b-34c2047fa9e1","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"74942dd9-6195-4820-80f5-9475b2ae786c","slug":"c-rock","label":"C-Rock","parent_id":"104fb080-2949-4c5d-ba0b-34c2047fa9e1","definition_md":"","position":102,"album_count":0,"children":[]}]},{"id":"382b2e91-910c-4432-84de-1035960455d7","slug":"cantopop","label":"Cantopop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**칸토팝**(*Cantopop*, *Cantonese pop*)은 홍콩을 중심으로 광둥어(*Cantonese*)로 노래되는 **광둥어권 대중음악**으로, 1970년대 홍콩에서 영어권 팝과 재즈의 영향을 받은 현지 음악이 독자적인 형태를 갖추면서 탄생했다. 서양 팝의 편곡 방식에 중국 전통 선율의 서정성을 결합하는 것이 특징이며, 발라드 중심의 감성적인 가사가 장르의 핵심 정서를 이룬다.\n\n레슬리 청(*Leslie Cheung*, 장국영)과 아니타 뮤이(*Anita Mui*, 매염방)가 1980~90년대 칸토팝의 전성기를 이끈 대표 아이콘이며, 4대 천왕으로 불린 재키 청(*Jacky Cheung*, 장학우)·앤디 라우(*Andy Lau*, 유덕화)·레온 라이(*Leon Lai*, 여명)·아론 콰이(*Aaron Kwok*, 곽부성)가 장르를 대중화했다. 홍콩의 정치적 변화와 함께 위상이 달라졌으나 동남아시아 화교권 전반에 깊은 영향을 남겼다.","position":15,"album_count":0,"children":[]},{"id":"336f341e-9731-49ad-b1e6-aacd9dc4228c","slug":"sophisti-pop","label":"Sophisti-Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**소피스티-팝**(*sophisti-pop*)은 1980년대 중반 영국에서 발전한 팝 장르로, 신스팝(*synth-pop*)과 포스트펑크(*post-punk*)의 전자음향 위에 재즈·소울·클래식에서 차용한 세련된 코드 진행과 편곡을 결합한 것이 특징이다. 이름 그대로 '세련됨(*sophisticated*)'을 미학적 목표로 삼는다.\n\n더 스타일 카운실(*The Style Council*)·어소시에이츠(*Associates*)·스완 레이크(*Swing Out Sister*) 등이 대표 아티스트이며, 고급스러운 뮤직비디오와 패션도 이 장르의 정체성을 구성했다. 소피스티-팝은 배로크 팝(*baroque pop*)이나 챔버 팝(*chamber pop*)과 취향적 친족 관계에 있지만, 전자적 질감과 1980년대 도시적 감수성에서 구별된다.","position":16,"album_count":0,"children":[]},{"id":"3a6c871a-99f7-4511-a6f2-211161da3880","slug":"sunshine-pop","label":"Sunshine Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**선샤인 팝**(*sunshine pop*)은 1960년대 중반 미국 캘리포니아에서 꽃핀 팝 장르로, 밝고 낙관적인 멜로디, 두꺼운 보컬 하모니, 오케스트라 편곡을 특징으로 한다. 서핑 팝(*surf pop*)의 에너지와 브릴 빌딩(*Brill Building*) 팝의 세공이 결합해 탄생했다.\n\n비치 보이스(*The Beach Boys*)의 《Pet Sounds》(1966)가 이 흐름의 정점으로 꼽히며, 마마스 앤 파파스(*The Mamas & the Papas*)·해퍼닝스(*The Happenings*) 등이 동시대 대표 밴드다. 선샤인 팝은 이후 소프트 록(*soft rock*)과 버블검(*bubblegum*) 팝으로 이어지며 미국 팝의 낙관주의 전통을 형성했다.","position":17,"album_count":0,"children":[]},{"id":"b16c2e9f-acab-444b-9909-9c6cd973d522","slug":"teen-pop","label":"Teen Pop","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**틴 팝**(*teen pop*)은 10대 청소년을 주요 청중이자 주인공으로 삼는 팝 장르로, 밝고 친근한 멜로디, 사랑과 청춘을 다루는 가사, 외모와 댄스 퍼포먼스를 강조하는 아이돌 중심 마케팅이 특징이다. 특정 시대의 독자적 장르라기보다 각 시대마다 10대 시장을 겨냥해 재생산되는 팝의 한 형태다.\n\n1990년대 말~2000년대 초에 브리트니 스피어스(*Britney Spears*)·NSYNC·백스트리트 보이스(*Backstreet Boys*) 등이 틴 팝 황금기를 이끌었으며, 한국의 K-팝 아이돌 시스템도 틴 팝의 문법을 흡수·발전시킨 것으로 볼 수 있다. 틴 팝은 댄스팝(*dance-pop*)·버블검(*bubblegum*) 팝과 중첩되는 지점이 많지만, 타깃 층의 연령대와 그에 맞춘 이미지 전략에서 명확히 구별된다.","position":18,"album_count":0,"children":[{"id":"fae055b7-40ff-4f5b-971c-b179645f777d","slug":"boy-band","label":"Boy Band","parent_id":"b16c2e9f-acab-444b-9909-9c6cd973d522","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"f1511379-7e24-4823-8f75-658cb5da07b6","slug":"girl-group","label":"Girl Group","parent_id":"b16c2e9f-acab-444b-9909-9c6cd973d522","definition_md":"","position":102,"album_count":0,"children":[]}]},{"id":"f809b5c7-8e02-40c8-8011-c3862dacffe7","slug":"bubblegum","label":"Bubblegum","parent_id":"5d1d07df-0f88-49b7-8b64-1e371aac0638","definition_md":"**버블검 팝**(*bubblegum pop*)은 1960년대 후반 미국에서 어린이와 십대 초반을 주요 청중으로 설계된 **극도로 달콤하고 단순한 팝** 하위 장르다. 짧은 러닝타임, 반복되는 후렴구, 장난스럽고 밝은 가사, 그리고 지나치다 싶을 만큼 경쾌한 멜로디가 특징이며, 상업적 의도가 예술적 야심보다 명백히 앞서는 장르로 평가된다.\n\n아치스(*The Archies*)의 〈Sugar, Sugar〉(1969)가 버블검 팝의 정의적인 곡으로 꼽히며, 1910 프루트검 컴퍼니(*1910 Fruitgum Company*) 등도 이 시기를 대표한다. 이후 버블검의 감수성은 1990년대 보이밴드·걸그룹 팝, 그리고 K-팝 초기 아이돌 음악에도 영향을 미쳤다.","position":19,"album_count":0,"children":[]}]},{"id":"19d77d64-1636-4622-8236-649702e5727d","slug":"latin","label":"Latin","parent_id":null,"definition_md":"**라틴 음악**(*Latin music*)은 라틴아메리카와 이베리아반도에 뿌리를 둔 음악 전통의 총칭으로, 아프리카·유럽·원주민 문화가 수백 년에 걸쳐 혼합되며 형성된 광대한 스펙트럼을 아우른다.\n\n음악적으로는 **싱코페이션**(*syncopation*)과 폴리리듬(*polyrhythm*)이 핵심이다. 콩가·봉고·팀발레스 같은 타악기 편성이 리듬의 뼈대를 이루고, 기타·트레스·아코디언 등 현악기와 브라스 섹션이 멜로디와 하모니를 담당한다. 살사(*salsa*)의 클라베 리듬, 보사노바(*bossa nova*)의 절제된 스윙, 탱고(*tango*)의 밀롱가 리듬처럼 하위 장르마다 고유한 리듬 어법이 분화돼 있다.\n\n20세기 들어 라틴 음악은 미국 대중음악과 교차하며 세계적 영향력을 키웠다. 1950~60년대 살사와 맘보(*mambo*)의 뉴욕 붐, 1980~90년대 라틴 팝(*Latin pop*)의 상업적 확장, 2000년대 이후 레게톤(*reggaeton*)의 글로벌 지배까지 파고가 계속됐다. 카를로스 산타나(*Carlos Santana*), 글로리아 에스테판(*Gloria Estefan*), 마크 앤서니(*Marc Anthony*), 제이 발빈(*J Balvin*)은 각 시대를 대표하는 이름들이다.\n\n한국에서는 1990년대 라틴 팝 붐을 거쳐 2010년대 레게톤과 살사의 댄스 문화가 확산됐고, 케이팝 제작에도 라틴 리듬이 빈번하게 흡수되고 있다.","position":2,"album_count":53,"children":[{"id":"fe733fc6-a5b9-4068-9406-cb64ea5cc4d8","slug":"reggaeton","label":"Reggaeton","parent_id":"19d77d64-1636-4622-8236-649702e5727d","definition_md":"**레게톤**(*reggaeton*)은 1990년대 푸에르토리코를 중심으로 자메이카 댄스홀(*dancehall*)과 힙합, 라틴 카리브 리듬이 결합해 탄생한 장르로, **뎀보우**(*dembow*)라 불리는 오프비트 강세의 드럼 패턴이 이 장르의 가장 뚜렷한 식별 요소다. 스페인어 래핑과 훅 중심의 구조, 저음이 풍부한 프로덕션이 살사나 메렝게와의 주요 구별점이다.\n\n대디 양키(*Daddy Yankee*)의 〈Gasolina〉(2004)가 장르를 전 세계에 알린 기점으로 자주 언급되며, 이후 J. 발빈(*J Balvin*)·배드 버니(*Bad Bunny*) 등이 팝·트랩과의 크로스오버를 통해 2010년대 후반 레게톤을 글로벌 팝 시장의 주류 문법으로 끌어올렸다.","position":1,"album_count":0,"children":[{"id":"24b6da01-41f2-40c1-b386-af295e800e57","slug":"neoperreo","label":"Neoperreo","parent_id":"fe733fc6-a5b9-4068-9406-cb64ea5cc4d8","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"1afb222c-e184-4cf0-9d71-dc136594640d","slug":"reggaeton-romantico","label":"Reggaeton Romántico","parent_id":"fe733fc6-a5b9-4068-9406-cb64ea5cc4d8","definition_md":"","position":102,"album_count":0,"children":[]},{"id":"f0ca14e3-d508-4f00-85bc-4824392071ff","slug":"perreo","label":"Perreo","parent_id":"fe733fc6-a5b9-4068-9406-cb64ea5cc4d8","definition_md":"","position":103,"album_count":0,"children":[]},{"id":"44d0aad7-73bb-4ffc-ad93-ba42725acc08","slug":"trap-latino","label":"Trap Latino","parent_id":"fe733fc6-a5b9-4068-9406-cb64ea5cc4d8","definition_md":"","position":104,"album_count":0,"children":[]},{"id":"ef0ba0cd-17ee-401c-908d-719545556645","slug":"dembow","label":"Dembow","parent_id":"fe733fc6-a5b9-4068-9406-cb64ea5cc4d8","definition_md":"","position":105,"album_count":0,"children":[]},{"id":"2ea69ba9-dd2e-408c-aa8b-8fd93048d577","slug":"reggaeton-mexa","label":"Reggaeton Mexa","parent_id":"fe733fc6-a5b9-4068-9406-cb64ea5cc4d8","definition_md":"","position":106,"album_count":0,"children":[]}]},{"id":"e614381e-00e0-4b68-895a-4409d905e239","slug":"salsa","label":"Salsa","parent_id":"19d77d64-1636-4622-8236-649702e5727d","definition_md":"**살사**(*salsa*)는 1960~70년대 뉴욕의 라틴계 이민자 커뮤니티에서 쿠바의 손(*son*)·과라차(*guaracha*)·맘보(*mambo*)를 재료로 재창조된 댄스 음악이다. 클라베(*clave*) 리듬이 모든 구성 요소를 묶는 뼈대 역할을 하며, 피아노·콩가·봉고·트럼펫·트롬본으로 이루어진 **살사 오케스트라**의 층층이 쌓이는 합주가 이 장르 특유의 풍성하고 뜨거운 질감을 만든다.\n\n페니아 레코드(*Fania Records*)와 그 소속 아티스트들—세리아 크루스(*Celia Cruz*)·루벤 블라데스(*Rubén Blades*)·윌리 콜론(*Willie Colón*)—이 살사의 황금기를 이끈 주역으로 꼽힌다. 이후 로맨틱한 사운드를 강조한 **살사 로만티카**(*salsa romántica*)와 어두운 서사를 담은 살사 두라(*salsa dura*)로 분화하며 다양한 지역 방언을 형성했다.","position":2,"album_count":0,"children":[{"id":"79b48ea4-7053-4f10-b7f0-5369d26cf6a7","slug":"salsa-dura","label":"Salsa Dura","parent_id":"e614381e-00e0-4b68-895a-4409d905e239","definition_md":"","position":101,"album_count":0,"children":[]},{"id":"ba9c16c2-ba4a-484a-9f83-cdbdc7a54ae0","slug":"salsa-romantica","label":"Salsa Rom