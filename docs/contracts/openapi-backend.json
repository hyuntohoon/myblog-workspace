{
  "openapi": "3.1.0",
  "info": {
    "title": "Blog Backend (Lambda/Mangum)",
    "version": "0.1.0"
  },
  "paths": {
    "/api/categories": {
      "get": {
        "tags": [
          "categories"
        ],
        "summary": "List Categories",
        "operationId": "list_categories_api_categories_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CategoryListResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "categories"
        ],
        "summary": "Add Category",
        "operationId": "add_category_api_categories_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AddCategoryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/posts": {
      "post": {
        "tags": [
          "posts"
        ],
        "summary": "Create Post",
        "operationId": "create_post_api_posts_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WritePostRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WritePostResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/metrics/batch": {
      "post": {
        "tags": [
          "metrics"
        ],
        "summary": "Batch Metrics",
        "operationId": "batch_metrics_api_metrics_batch_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MetricsBatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MetricsBatchResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/db/ping": {
      "get": {
        "summary": "Ping",
        "operationId": "ping_api_db_ping_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddCategoryRequest": {
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "AddCategoryRequest"
      },
      "CategoryListResponse": {
        "properties": {
          "categories": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Categories"
          }
        },
        "type": "object",
        "required": [
          "categories"
        ],
        "title": "CategoryListResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MetricsBatchRequest": {
        "properties": {
          "slugs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Slugs"
          }
        },
        "type": "object",
        "required": [
          "slugs"
        ],
        "title": "MetricsBatchRequest"
      },
      "MetricsBatchResponse": {
        "properties": {
          "data": {
            "additionalProperties": {
              "$ref": "#/components/schemas/PostMetrics"
            },
            "type": "object",
            "title": "Data"
          }
        },
        "type": "object",
        "required": [
          "data"
        ],
        "title": "MetricsBatchResponse"
      },
      "PostMetrics": {
        "properties": {
          "likes": {
            "type": "integer",
            "title": "Likes"
          },
          "comments": {
            "type": "integer",
            "title": "Comments"
          }
        },
        "type": "object",
        "required": [
          "likes",
          "comments"
        ],
        "title": "PostMetrics"
      },
      "RecommendedTrackInput": {
        "properties": {
          "album_id": {
            "type": "string",
            "title": "Album Id"
          },
          "track_id": {
            "type": "string",
            "title": "Track Id"
          },
          "position": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Position"
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "type": "object",
        "required": [
          "album_id",
          "track_id"
        ],
        "title": "RecommendedTrackInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "WritePostRequest": {
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "body_mdx": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Body Mdx"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "default": ""
          },
          "posted_date": {
            "type": "string",
            "format": "date",
            "title": "Posted Date"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "archived"
            ],
            "title": "Status",
            "default": "published"
          },
          "category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "search_index": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Search Index"
          },
          "album_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Album Ids"
          },
          "artist_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Artist Ids"
          },
          "rating": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 5.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Rating"
          },
          "rating_scale": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Rating Scale",
            "default": 5
          },
          "album_classics": {
            "additionalProperties": {
              "type": "boolean"
            },
            "type": "object",
            "title": "Album Classics"
          },
          "recommended_tracks": {
            "items": {
              "$ref": "#/components/schemas/RecommendedTrackInput"
            },
            "type": "array",
            "title": "Recommended Tracks"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "WritePostRequest"
      },
      "WritePostResponse": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "slug": {
            "type": "string",
            "title": "Slug"
          }
        },
        "type": "object",
        "required": [
          "id",
          "slug"
        ],
        "title": "WritePostResponse"
      }
    }
  }
}