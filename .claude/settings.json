{
  "permissions": {
    "allow": [
      "Bash(aws ssm get-parameter:*)",
      "Bash(aws ssm get-parameters-by-path:*)",
      "Bash(aws secretsmanager get-secret-value:*)",
      "Bash(aws logs get-log-events:*)",
      "Bash(aws logs filter-log-events:*)",
      "Bash(aws logs describe-log-streams:*)",
      "Bash(aws logs describe-log-groups:*)",
      "Bash(gh run watch:*)",
      "Bash(git fetch:*)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.env)",
      "Read(**/secrets.yaml)",
      "Read(**/secrets.yml)",
      "Read(**/config.local.json)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/.credentials.json)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.env)",
      "Write(**/secrets.yaml)",
      "Write(**/secrets.yml)",
      "Write(**/config.local.json)",
      "Write(**/*.pem)",
      "Write(**/*.key)",
      "Write(**/credentials)",
      "Write(**/credentials.json)",
      "Write(**/.credentials.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.env)",
      "Edit(**/secrets.yaml)",
      "Edit(**/secrets.yml)",
      "Edit(**/config.local.json)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/credentials)",
      "Edit(**/credentials.json)",
      "Edit(**/.credentials.json)"
    ]
  }
}
