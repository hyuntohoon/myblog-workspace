# Subordinate repos managed independently
myblog_front/
myblog_backend/
myblog_music/
myblog_worker/
myblog_shared_db/

# Terraform
infra/tfplan
infra/*.tfplan

# OS
.DS_Store

# Python
__pycache__/
*.pyc

# Env / secrets
.env
.env.local
*.pem
*.key

# IDE
.idea/
.vscode/
.claude/hooks/
.claude/launch.json
.claude/worktrees/
# Plan-mode working files — session-local; the canonical plan lives in docs/rfcs/ + docs/plan.md
.claude/plans/

# Allure test artifacts (STAB-6)
allure-results/
allure-report/

# Editor Buckit idea reports — unpublished editorial direction (FEAT-editor-buckit Stage 0).
# .gitkeep keeps the dir; reports stay local. Commit a report deliberately if wanted.
docs/editorial/ideas/*.md

# Editor Buckit nightly skeletons — unpublished editorial direction (FEAT-editor-buckit Stage 1, OQ9).
# .gitkeep keeps the dir; per-night skeleton dirs stay local. Commit deliberately if wanted.
docs/buckit/**/*.md

# UI/UX audit scratch — per-page screenshots + draft PR bodies from front audit runs.
# One-off, regenerable; the audit's outcome lands in docs/archive + the front PR. Stays local.
.uiux-audit/

# FEAT-lyrics-corpus Step 2 Phase 1 audit JSON + run log — per-run sample output for
# manual precision review (includes lyric snippets). Regenerable, local-only, never committed.
tools/.lyrics-phase1-*.json
tools/.lyrics-phase1-*.log
tools/.lyrics-phase2-*.txt
tools/.lyrics-phase2-*.log

# lyrics probe outputs (Step-1 read-only probe artifacts)
tools/out/
