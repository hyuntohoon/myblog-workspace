# Subordinate repos managed independently
myblog_front/
myblog_backend/
myblog_music/
myblog_worker/
myblog_shared_db/

# Terraform
infra/tfplan
infra/*.tfplan

# OS
.DS_Store

# Python
__pycache__/
*.pyc

# Env / secrets
.env
.env.local
*.pem
*.key

# IDE
.idea/
.vscode/

# Claude project configuration: the shared subagent definitions are tracked, all
# other Claude state (settings.local.json, plans/, worktrees/, hooks) stays local.
# Mirrors the .codex block below — the two agent sets are twins and drift silently
# when only one is version-controlled (ws #847 → #910).
.claude/*
!.claude/agents/
.claude/agents/*
!.claude/agents/architect.md
!.claude/agents/debugger.md
!.claude/agents/explorer.md
!.claude/agents/planner.md
!.claude/agents/reviewer.md
!.claude/agents/test-engineer.md

# Codex project configuration is shared; runtime state remains local.
.codex/*
!.codex/config.toml
!.codex/hooks.json
!.codex/agents/
.codex/agents/*
!.codex/agents/architect.toml
!.codex/agents/debugger.toml
!.codex/agents/explorer.toml
!.codex/agents/planner.toml
!.codex/agents/reviewer.toml
!.codex/agents/test-engineer.toml
!.codex/hooks/
.codex/hooks/*
!.codex/hooks/guard-bash.sh
!.codex/hooks/guard-file-edits.sh
!.codex/hooks/retire-session-claim.sh
!.codex/rules/
.codex/rules/*
!.codex/rules/default.rules

# Allure test artifacts (STAB-6)
allure-results/
allure-report/

# Editor Buckit idea reports — unpublished editorial direction (FEAT-editor-buckit Stage 0).
# .gitkeep keeps the dir; reports stay local. Commit a report deliberately if wanted.
docs/editorial/ideas/*.md

# Editor Buckit nightly skeletons — unpublished editorial direction (FEAT-editor-buckit Stage 1, OQ9).
# .gitkeep keeps the dir; per-night skeleton dirs stay local. Commit deliberately if wanted.
docs/buckit/**/*.md

# UI/UX audit scratch — per-page screenshots + draft PR bodies from front audit runs.
# One-off, regenerable; the audit's outcome lands in docs/archive + the front PR. Stays local.
.uiux-audit/

# FEAT-lyrics-corpus Step 2 Phase 1 audit JSON + run log — per-run sample output for
# manual precision review (includes lyric snippets). Regenerable, local-only, never committed.
tools/.lyrics-phase1-*.json
tools/.lyrics-phase1-*.log
tools/.lyrics-phase2-*.txt
tools/.lyrics-phase2-*.log

# Lyrics-annotation design mockups — the assembled pages and lux_mock_data.json inline complete
# lyrics + Genius annotation bodies, and THIS REPO IS PUBLIC. Same bar as tools/.lyrics-phase1-*.
# .gitkeep keeps the dir; the lyric-free fragments in houses/ ARE committed and regenerate them.
docs/design/lyrics-annotations/local/*
!docs/design/lyrics-annotations/local/.gitkeep

# lyrics probe outputs (Step-1 read-only probe artifacts)
tools/out/

# tool caches
.pnpm-store/
